# Required paths. Keep model, data and outputs outside this repository.
MODEL_PATH=/path/to/Qwen3-VL-8B-Instruct
DATASET=/path/to/train.jsonl
OUTPUT_DIR=/path/to/outputs/deepvoyager-vl-8b

# Runtime: bundled uses repository source; installed uses an existing megatron CLI.
SWIFT_RUNTIME=bundled
PYTHON_BIN=python3

# Distributed topology.
NPROC_PER_NODE=8
MASTER_PORT=29500
TENSOR_MODEL_PARALLEL_SIZE=4
CONTEXT_PARALLEL_SIZE=2
PIPELINE_MODEL_PARALLEL_SIZE=1
EXPERT_MODEL_PARALLEL_SIZE=1

# Training.
NUM_TRAIN_EPOCHS=4
MICRO_BATCH_SIZE=1
GLOBAL_BATCH_SIZE=64
MAX_LENGTH=131072
MAX_PIXELS=131072
LR=2e-5
MIN_LR=5e-7
LR_WARMUP_FRACTION=0.05
WEIGHT_DECAY=0.1
SAVE_STEPS=100
LOGGING_STEPS=5
PACKING=true
TRUNCATION_STRATEGY=delete
FREEZE_VIT=true
FREEZE_ALIGNER=true
SAVE_OPTIMIZER=true
SAVE_RNG=true
REPORT_TO=tensorboard

# Data workers and caches.
DATASET_NUM_PROC=128
DATALOADER_NUM_WORKERS=8
LOAD_FROM_CACHE_FILE=true
CACHE_ROOT=/path/to/cache/deepvoyager-vl-8b

# Cluster-specific communication settings; adjust for your fabric.
NCCL_NVLS_ENABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_ALGO=Ring
NCCL_PROTO=Simple
CUDA_DEVICE_MAX_CONNECTIONS=1
OMP_NUM_THREADS=16
